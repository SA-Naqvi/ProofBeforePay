# ── Required ────────────────────────────────────────────────────────────────
# Nebius Token Factory key: https://tokenfactory.nebius.com  (API keys section)
NEBIUS_API_KEY=
# Tavily key: https://app.tavily.com
TAVILY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# OpenAI-compatible Token Factory endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model tiers. If an ID is not in your catalog, the server picks the closest Nemotron match at startup.
# Run `python scripts/check_setup.py` (from the repo root) to see the exact IDs available to your key.
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# USD per 1M tokens, used for the live cost telemetry
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
# Reads the text out of uploaded screenshots (Nemotron does all the reasoning). The first one that answers is used.
MODEL_VISION=openbmb/MiniCPM-V-4_5,google/gemma-3-27b-it
PRICE_VISION_IN=0.20
PRICE_VISION_OUT=0.60

# The investigation loop's budget: rounds of follow-up lookups, total lookups, and how many hops a lookup may be
# from the original claim. Lookups that find an inconsistency open new ones until one of these runs out.
MAX_ROUNDS=4
MAX_LEADS=16
MAX_DEPTH=3
# Optional keyed sources. Without them those lookups are reported as "not checked" (never as evidence either way).
# Google Cloud Vision (Web Detection) powers reverse-image search of factory photos.
GOOGLE_VISION_API_KEY=
# OpenCorporates API token for structured company-registry lookups. Without it, registries are searched through Tavily.
OPENCORPORATES_API_KEY=

# ── PayPal credits (sandbox by default) ─────────────────────────────────────
# Checks cost credits, bought in packs through PayPal Orders v2 using PayPal's official server SDK (paypal-server-sdk,
# generated by APIMatic). Leave the keys empty to keep checks free. Get sandbox keys at https://developer.paypal.com
# (Apps & Credentials, Sandbox tab), then pay with a sandbox *buyer* account (Testing Tools, Sandbox Accounts).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = PayPal's test environment, no real money. Only set "live" when you really want to be paid.
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
# Credits one check costs, and credits given free to each new account (0 = none).
CREDITS_PER_CHECK=1
STARTING_CREDITS=0
# Packs for sale as id:credits:price:Label. Prices are set here, never taken from the browser.
CREDIT_PACKS=starter:5:5.00:Starter,standard:15:12.00:Standard,bulk:40:28.00:Bulk

# Public-demo protection
RUNS_PER_IP_PER_HOUR=3
MAX_RUNS_PER_DAY=150
MAX_CONCURRENT_RUNS=4
MAX_CLAIMS=6
# Hard ceiling on total Token Factory spend (USD). Live checks pause once it's reached; the total is kept
# in data/spend.json. Each run holds back RUN_RESERVE_USD (a worst case) until its real cost is known.
MAX_SPEND_USD=1.00
RUN_RESERVE_USD=0.15

# Browser origins allowed to call the API (the Next.js dev server). Not needed in production,
# where FastAPI serves the exported site itself.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase: accounts, saved investigations, feedback, messages and the spend ledger. Without it they live in
# memory until restart. SUPABASE_URL can be the project URL (https://<ref>.supabase.co) or its Postgres connection
# string. Use the SECRET key (service_role on older projects); it never reaches the browser. Create the tables by
# running apps/api/migrations/0001_init.sql, 0002_accounts.sql and then 0003_credits.sql in the Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Accounts. Sign-up codes are emailed through Resend (https://resend.com). EMAIL_FROM must use a domain you've
# verified in Resend; until then Resend only delivers to your own account email. Locally, with no key, codes are
# printed in the server log instead. ADMIN_EMAILS (comma-separated) can open /admin once they sign up.
RESEND_API_KEY=
EMAIL_FROM=ProofBeforePay <onboarding@resend.dev>
ADMIN_EMAILS=
# Until a domain is verified, codes Resend won't deliver go to this inbox instead (usually your Resend account email),
# labelled with who they're for. Leave empty once your domain is verified.
EMAIL_TEST_INBOX=
# One-click demo accounts for judges (create them with scripts/seed_demo_accounts.py). DEMO_LOGIN=off hides them.
DEMO_JUDGE_EMAIL=demo.judge@example.com
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_LOGIN=on
# The site's public address, used in emails. AUTH_SECRET signs one-time codes: set a long random value in production.
PUBLIC_URL=http://localhost:3000
AUTH_SECRET=
# production: never print codes in the log, and require Resend for sign-up.
APP_ENV=development
